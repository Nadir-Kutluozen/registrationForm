            <Button fx:id="addBtn" alignment="CENTER" contentDisplay="CENTER" mnemonicParsing="false" onAction="#add" prefHeight="38.0" prefWidth="100.0" style="-fx-background-color: none; -fx-border-color: #8c8c8c;" text="Add" textFill="#8c8c8c">

<BorderPane prefHeight="520.0" prefWidth="800.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.registrationform.registrationController">
   <center>
      <VBox alignment="CENTER" minWidth="-Infinity" prefHeight="443.0" prefWidth="800.0" BorderPane.alignment="CENTER">
         <children>
            <TextField fx:id="firstAndLastName" prefHeight="38.0" prefWidth="499.0" promptText="First &amp; Last name" style="-fx-background-radius: 0; -fx-background-color: none; -fx-border-width: 2; -fx-border-color: #8c8c8c;">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets left="150.0" right="150.0" />
               </VBox.margin>
               <font>
                  <Font size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="email" prefHeight="38.0" prefWidth="499.0" promptText="Email (xyz@farmingdale.edu)" style="-fx-background-radius: 0; -fx-background-color: none; -fx-border-width: 2; -fx-border-color: #8c8c8c;">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets left="150.0" right="150.0" top="20.0" />
               </VBox.margin>
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="dateOfBrith" prefHeight="38.0" prefWidth="499.0" promptText="Date of Birth (MM/DD/YYYY)" style="-fx-background-radius: 0; -fx-background-color: none; -fx-border-width: 2; -fx-border-color: #8c8c8c;">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets left="150.0" right="150.0" top="20.0" />
               </VBox.margin>
               <font>
                  <Font name="Arial" size="14.0" />
               </font>
            </TextField>
            <TextField fx:id="zipCode" prefHeight="38.0" prefWidth="499.0" promptText="Zip Code (XXXXX)" style="-fx-background-radius: 0; -fx-background-color: none; -fx-border-width: 2; -fx-border-color: #8c8c8c;">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <VBox.margin>
                  <Insets left="150.0" right="150.0" top="20.0" />

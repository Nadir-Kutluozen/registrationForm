<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>


<?import javafx.scene.control.Label?>
<BorderPane prefHeight="520.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.registrationform.ScreenView">
   <center>
      <VBox prefHeight="200.0" prefWidth="100.0" BorderPane.alignment="CENTER" />
   </center>
   <top>
      <Text strokeType="OUTSIDE" strokeWidth="0.0" text="Welcome" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets top="50.0" />
         </BorderPane.margin>
         <font>
            <Font size="24.0" />
         </font>
      </Text>
       <Label fx:id="userNamelabel" BorderPane.alignment="CENTER">
           <BorderPane.margin>
               <Insets top="50.0" />
           </BorderPane.margin>
           <font>
               <Font size="24.0" />
           </font>
       </Label>
   </top>
</BorderPane>
